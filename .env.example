# Easy!Appointments - Local secrets
#
# Copy this file to ".env" (same folder as "index.php") and fill in the values.
# The ".env" file is ignored by git and must never be committed.
#
# Variables defined in the real environment (web server, shell, container) take
# precedence over the values of this file.

# Password of the SMTP account used to send the appointment emails.
# The rest of the SMTP settings (host, user, port, encryption) live in
# "application/config/email.php".
# SMTP_PASSWORD=
